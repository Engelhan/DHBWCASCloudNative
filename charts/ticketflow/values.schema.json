{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ticketflow",
  "description": "Validiert den Kafka-/Messaging- sowie den catalogApi-/frontend-Teil (charts/ticketflow/templates/). Bewusst ohne additionalProperties:false auf Root-Ebene, damit weitere Abschnitte (reservation-worker, ...) ergaenzt werden koennen, ohne dieses Schema umzubauen.",
  "type": "object",
  "required": ["namespace", "kafka", "catalogApi", "frontend"],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "kafka": {
      "type": "object",
      "required": ["metadata", "version", "controller", "broker", "config", "topics"],
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["name", "namespace"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 }
          }
        },
        "version": { "type": "string", "minLength": 1 },
        "controller": { "$ref": "#/definitions/nodePool" },
        "broker": { "$ref": "#/definitions/nodePool" },
        "config": {
          "type": "object",
          "required": [
            "offsetsTopicReplicationFactor",
            "transactionStateLogReplicationFactor",
            "transactionStateLogMinIsr",
            "defaultReplicationFactor",
            "minInsyncReplicas"
          ],
          "properties": {
            "offsetsTopicReplicationFactor": { "type": "integer", "minimum": 1 },
            "transactionStateLogReplicationFactor": { "type": "integer", "minimum": 1 },
            "transactionStateLogMinIsr": { "type": "integer", "minimum": 1 },
            "defaultReplicationFactor": { "type": "integer", "minimum": 1 },
            "minInsyncReplicas": { "type": "integer", "minimum": 1 }
          }
        },
        "entityOperator": {
          "type": "object",
          "properties": {
            "topicOperator": { "$ref": "#/definitions/operatorResource" },
            "userOperator": { "$ref": "#/definitions/operatorResource" }
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "partitions", "replicationFactor"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "partitions": { "type": "integer", "minimum": 1 },
              "replicationFactor": { "type": "integer", "minimum": 1 },
              "config": { "type": "object" }
            }
          }
        }
      }
    },
    "catalogApi": {
      "type": "object",
      "required": ["replicas", "image", "service", "resources", "env", "database"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "required": ["port"],
          "properties": { "port": { "type": "integer", "minimum": 1 } }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "env": {
          "type": "object",
          "required": ["logLevel", "port", "reservationTopic", "kafkaBrokers"],
          "properties": {
            "logLevel": { "type": "string", "minLength": 1 },
            "port": { "type": "string", "minLength": 1 },
            "reservationTopic": { "type": "string", "minLength": 1 },
            "kafkaBrokers": { "type": "string", "minLength": 1 },
            "corsAllowedOrigin": { "type": "string" }
          }
        },
        "database": {
          "type": "object",
          "required": ["host", "port", "name", "sslMode", "credentialsSecretName"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "sslMode": { "type": "string", "minLength": 1 },
            "credentialsSecretName": { "type": "string", "minLength": 1 }
          }
        },
        "podDisruptionBudget": { "$ref": "#/definitions/podDisruptionBudget" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "minLength": 1 },
            "labels": { "type": "object" }
          }
        },
        "topologySpreadConstraint": { "$ref": "#/definitions/topologySpreadConstraint" }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["replicas", "image", "service", "resources", "ingress"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "service": {
          "type": "object",
          "required": ["port"],
          "properties": { "port": { "type": "integer", "minimum": 1 } }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "clusterIssuerName": { "type": "string" },
            "tlsSecretName": { "type": "string" }
          }
        },
        "podDisruptionBudget": { "$ref": "#/definitions/podDisruptionBudget" },
        "topologySpreadConstraint": { "$ref": "#/definitions/topologySpreadConstraint" }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "topologySpreadConstraint": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSkew": { "type": "integer", "minimum": 1 }
      }
    },
    "nodePool": {
      "type": "object",
      "required": ["replicas", "storage", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "storage": {
          "type": "object",
          "required": ["type", "size"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": { "type": "object" },
            "limits": { "type": "object" }
          }
        }
      }
    },
    "operatorResource": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "object",
          "properties": {
            "memoryLimit": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
