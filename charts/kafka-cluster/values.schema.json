{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ticketflow",
  "description": "Validates the Kafka/messaging and schema-registry values. No additionalProperties:false at the root, so new sections can be added.",
  "type": "object",
  "required": [
    "kafka",
    "schemaRegistry",
    "ticketflow"
  ],
  "properties": {
    "schemaRegistry": {
      "type": "object",
      "required": [
        "groupId",
        "job"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "Empty = derived from ticketflow.namespaces.kafka."
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "$ref": "#/definitions/operatorResources"
        }
      }
    },
    "kafka": {
      "type": "object",
      "required": [
        "version",
        "controller",
        "broker",
        "config",
        "topics",
        "users",
        "entityOperator",
        "kafkaExporter"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "controller": {
          "$ref": "#/definitions/nodePool"
        },
        "broker": {
          "$ref": "#/definitions/nodePool"
        },
        "config": {
          "type": "object",
          "required": [
            "offsetsTopicReplicationFactor",
            "transactionStateLogReplicationFactor",
            "transactionStateLogMinIsr",
            "defaultReplicationFactor",
            "minInsyncReplicas"
          ],
          "properties": {
            "offsetsTopicReplicationFactor": {
              "type": "integer",
              "minimum": 1
            },
            "transactionStateLogReplicationFactor": {
              "type": "integer",
              "minimum": 1
            },
            "transactionStateLogMinIsr": {
              "type": "integer",
              "minimum": 1
            },
            "defaultReplicationFactor": {
              "type": "integer",
              "minimum": 1
            },
            "minInsyncReplicas": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "entityOperator": {
          "type": "object",
          "properties": {
            "topicOperator": {
              "$ref": "#/definitions/operatorResources"
            },
            "userOperator": {
              "$ref": "#/definitions/operatorResources"
            }
          },
          "required": [
            "topicOperator",
            "userOperator"
          ]
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "partitions",
              "replicationFactor"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "partitions": {
                "type": "integer",
                "minimum": 1
              },
              "replicationFactor": {
                "type": "integer",
                "minimum": 1
              },
              "config": {
                "type": "object"
              }
            }
          }
        },
        "users": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "acls"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "passwordSecretName": {
                "type": "string",
                "minLength": 1
              },
              "acls": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "resource",
                    "operations"
                  ],
                  "properties": {
                    "resource": {
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "topic",
                            "group",
                            "cluster",
                            "transactionalId"
                          ]
                        },
                        "name": {
                          "type": "string"
                        },
                        "patternType": {
                          "type": "string",
                          "enum": [
                            "literal",
                            "prefix"
                          ]
                        }
                      }
                    },
                    "operations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "kafkaExporter": {
          "$ref": "#/definitions/operatorResources"
        }
      }
    },
    "ticketflow": {
      "type": "object",
      "description": "Central values from gitops/env/cluster.yaml (passed in by ArgoCD).",
      "required": [
        "namespaces",
        "kafka"
      ],
      "properties": {
        "namespaces": {
          "type": "object",
          "required": [
            "app",
            "kafka"
          ],
          "properties": {
            "app": {
              "type": "string",
              "minLength": 1
            },
            "kafka": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "kafka": {
          "type": "object",
          "required": [
            "clusterName"
          ],
          "properties": {
            "clusterName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "definitions": {
    "nodePool": {
      "type": "object",
      "required": [
        "replicas",
        "storage",
        "resources",
        "jvmOptions"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "object",
          "required": [
            "type",
            "size"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "jvmOptions": {
          "type": "object",
          "required": [
            "heap"
          ],
          "properties": {
            "heap": {
              "type": "string",
              "pattern": "^[0-9]+[mg]$",
              "description": "Set as -Xms and -Xmx (e.g. 512m). Must stay well below resources.limits.memory; off-heap and page cache need the rest."
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "description": "CPU and memory must be set as both request and limit.",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        }
      }
    },
    "operatorResources": {
      "type": "object",
      "required": [
        "resources"
      ],
      "properties": {
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    }
  }
}
