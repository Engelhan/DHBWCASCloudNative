{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "notification-worker",
  "type": "object",
  "required": [
    "replicaCount",
    "config",
    "ticketflow",
    "resources",
    "podSecurityContext",
    "securityContext",
    "podMonitor",
    "networkPolicy",
    "topologySpreadConstraint"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "description": "Optionaler Override. Normalerweise leer - Registry/Tag kommen aus ticketflow.imageRegistry/.imageTag.",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "not": {
            "const": "latest"
          }
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "resultTopic",
        "consumerGroup",
        "kafkaSasl"
      ],
      "properties": {
        "kafkaBrokers": {
          "type": "string",
          "description": "Leer = abgeleitet aus ticketflow.kafka.clusterName + ticketflow.namespaces.kafka."
        },
        "resultTopic": {
          "type": "string",
          "minLength": 1
        },
        "consumerGroup": {
          "type": "string",
          "minLength": 1
        },
        "notifyMaxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "registryUrl": {
          "type": "string",
          "description": "Leer = abgeleitet aus ticketflow.namespaces.kafka."
        },
        "registryGroupId": {
          "type": "string",
          "minLength": 1
        },
        "kafkaTls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "kafkaSasl": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "username": {
              "type": "string"
            },
            "secretName": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "username",
              "secretName"
            ],
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1
              },
              "secretName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "smtp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "tlsMode": {
              "type": "string",
              "enum": [
                "none",
                "starttls",
                "tls"
              ]
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "host",
              "from"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "secret": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "kafkaTlsCaCert": {
          "type": "string"
        },
        "kafkaTlsClientCert": {
          "type": "string"
        },
        "kafkaTlsClientKey": {
          "type": "string"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ticketflow": {
      "type": "object",
      "description": "Zentrale Werte aus gitops/env/cluster.yaml (von ArgoCD per Multi-Source durchgereicht).",
      "required": [
        "imageRegistry",
        "imageTag",
        "kafka",
        "namespaces"
      ],
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        },
        "imageTag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "namespaces": {
          "type": "object",
          "required": [
            "app",
            "kafka"
          ],
          "properties": {
            "app": {
              "type": "string",
              "minLength": 1
            },
            "kafka": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "kafka": {
          "type": "object",
          "required": [
            "clusterName"
          ],
          "properties": {
            "clusterName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "limits": {
          "$ref": "#/$defs/resourceQuantities"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "podMonitor": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "$ref": "#/$defs/toggle"
    },
    "topologySpreadConstraint": {
      "$ref": "#/$defs/topologySpreadConstraint"
    }
  },
  "if": {
    "properties": {
      "config": {
        "properties": {
          "kafkaTls": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "kafkaTls"
        ]
      }
    },
    "required": [
      "config"
    ]
  },
  "then": {
    "properties": {
      "secret": {
        "required": [
          "kafkaTlsCaCert",
          "kafkaTlsClientCert",
          "kafkaTlsClientKey"
        ],
        "properties": {
          "kafkaTlsCaCert": {
            "type": "string",
            "minLength": 1
          },
          "kafkaTlsClientCert": {
            "type": "string",
            "minLength": 1
          },
          "kafkaTlsClientKey": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "resourceQuantities": {
      "type": "object",
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ]
        },
        "memory": {
          "type": "string"
        }
      }
    },
    "toggle": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "topologySpreadConstraint": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
