{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ticketflow-app",
  "description": "catalog-api + frontend. Beide Komponenten teilen sich dieselbe Key-Struktur wie charts/reservation-worker und charts/notification-worker - siehe charts/README.md ## Muster fuer Applikations-Charts.",
  "type": "object",
  "required": [
    "ticketflow",
    "catalogApi",
    "frontend"
  ],
  "properties": {
    "ticketflow": {
      "type": "object",
      "description": "Zentrale Werte aus gitops/env/cluster.yaml (von ArgoCD per Multi-Source durchgereicht).",
      "required": [
        "dnsZone",
        "imageRegistry",
        "imageTag",
        "kafka",
        "namespaces",
        "postgres"
      ],
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        },
        "imageTag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "dnsZone": {
          "type": "string",
          "minLength": 1
        },
        "namespaces": {
          "type": "object",
          "required": [
            "app",
            "kafka"
          ],
          "properties": {
            "app": {
              "type": "string",
              "minLength": 1
            },
            "kafka": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "kafka": {
          "type": "object",
          "required": [
            "clusterName"
          ],
          "properties": {
            "clusterName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "postgres": {
          "type": "object",
          "required": [
            "databaseName"
          ],
          "properties": {
            "databaseName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "catalogApi": {
      "type": "object",
      "required": [
        "image",
        "replicaCount",
        "resources",
        "podSecurityContext",
        "securityContext",
        "config",
        "database",
        "service",
        "serviceMonitor",
        "podDisruptionBudget",
        "topologySpreadConstraint"
      ],
      "properties": {
        "image": {
          "$ref": "#/$defs/imageOverride"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "$ref": "#/$defs/resourceQuantities"
            },
            "limits": {
              "$ref": "#/$defs/resourceQuantities"
            }
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "config": {
          "type": "object",
          "required": [
            "logLevel",
            "port",
            "reservationTopic",
            "registryGroupId",
            "kafkaSasl"
          ],
          "properties": {
            "logLevel": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            },
            "port": {
              "type": "string",
              "minLength": 1
            },
            "reservationTopic": {
              "type": "string",
              "minLength": 1
            },
            "kafkaBrokers": {
              "type": "string",
              "description": "Leer = abgeleitet aus ticketflow.kafka.clusterName + ticketflow.namespaces.kafka."
            },
            "corsAllowedOrigin": {
              "type": "string"
            },
            "registryUrl": {
              "type": "string",
              "description": "Leer = abgeleitet aus ticketflow.namespaces.kafka."
            },
            "registryGroupId": {
              "type": "string",
              "minLength": 1
            },
            "kafkaSasl": {
              "type": "object",
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "username": {
                  "type": "string"
                },
                "secretName": {
                  "type": "string"
                }
              }
            }
          }
        },
        "database": {
          "type": "object",
          "required": [
            "port",
            "sslMode"
          ],
          "properties": {
            "host": {
              "type": "string",
              "description": "Leer = <ticketflow.postgres.databaseName>-postgres-cluster-rw (gleicher Namespace)."
            },
            "port": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "description": "Leer = ticketflow.postgres.databaseName."
            },
            "sslMode": {
              "type": "string",
              "enum": [
                "disable",
                "allow",
                "prefer",
                "require",
                "verify-ca",
                "verify-full"
              ]
            },
            "credentialsSecretName": {
              "type": "string",
              "description": "Leer = <ticketflow.postgres.databaseName>-postgres-cluster-app (von CNPG selbst erzeugt)."
            }
          }
        },
        "service": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "minLength": 1
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "podDisruptionBudget": {
          "$ref": "#/$defs/podDisruptionBudget"
        },
        "topologySpreadConstraint": {
          "$ref": "#/$defs/topologySpreadConstraint"
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": [
        "image",
        "replicaCount",
        "resources",
        "podSecurityContext",
        "securityContext",
        "service",
        "ingress",
        "podDisruptionBudget",
        "topologySpreadConstraint"
      ],
      "properties": {
        "image": {
          "$ref": "#/$defs/imageOverride"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "$ref": "#/$defs/resourceQuantities"
            },
            "limits": {
              "$ref": "#/$defs/resourceQuantities"
            }
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "ingress": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string",
              "description": "Leer = wird als ticketflow.<ticketflow.dnsZone> abgeleitet."
            },
            "className": {
              "type": "string",
              "minLength": 1
            },
            "clusterIssuerName": {
              "type": "string",
              "minLength": 1
            },
            "tlsSecretName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "podDisruptionBudget": {
          "$ref": "#/$defs/podDisruptionBudget"
        },
        "topologySpreadConstraint": {
          "$ref": "#/$defs/topologySpreadConstraint"
        }
      }
    }
  },
  "$defs": {
    "imageOverride": {
      "type": "object",
      "description": "Optionaler Override. Normalerweise leer - Registry/Tag kommen aus ticketflow.imageRegistry/.imageTag.",
      "required": [
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "not": {
            "const": "latest"
          }
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "resourceQuantities": {
      "type": "object",
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ]
        },
        "memory": {
          "type": "string"
        }
      }
    },
    "databaseSecret": {
      "type": "object",
      "required": [
        "create"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "toggle": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "topologySpreadConstraint": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
