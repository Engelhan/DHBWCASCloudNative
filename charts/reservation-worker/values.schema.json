{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "reservation-worker",
  "type": "object",
  "required": [
    "replicaCount",
    "config",
    "database",
    "databaseSecret",
    "ticketflow"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "description": "Optionaler Override. Normalerweise leer - Registry/Tag kommen aus ticketflow.imageRegistry/.imageTag.",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "not": {
            "const": "latest"
          }
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "kafkaBrokers",
        "reservationTopic",
        "resultTopic",
        "consumerGroup",
        "registryUrl",
        "kafkaSasl",
        "keda"
      ],
      "properties": {
        "kafkaBrokers": {
          "type": "string",
          "minLength": 1
        },
        "reservationTopic": {
          "type": "string",
          "minLength": 1
        },
        "resultTopic": {
          "type": "string",
          "minLength": 1
        },
        "consumerGroup": {
          "type": "string",
          "minLength": 1
        },
        "processMaxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "processRetryBackoff": {
          "type": "string",
          "minLength": 1
        },
        "registryUrl": {
          "type": "string",
          "minLength": 1
        },
        "registryGroupId": {
          "type": "string",
          "minLength": 1
        },
        "logLevel": {
          "type": "string"
        },
        "httpAddr": {
          "type": "string"
        },
        "kafkaSasl": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "username": {
              "type": "string"
            },
            "secretName": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "username",
              "secretName"
            ],
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1
              },
              "secretName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "keda": {
          "type": "object",
          "required": [
            "minReplicaCount",
            "maxReplicaCount",
            "lagThreshold",
            "pollingInterval",
            "cooldownPeriod"
          ],
          "properties": {
            "minReplicaCount": {
              "type": "integer",
              "minimum": 0
            },
            "maxReplicaCount": {
              "type": "integer",
              "minimum": 1
            },
            "lagThreshold": {
              "type": "string",
              "minLength": 1
            },
            "pollingInterval": {
              "type": "integer",
              "minimum": 1
            },
            "cooldownPeriod": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "host",
        "port",
        "name",
        "sslMode"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sslMode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "databaseSecret": {
      "type": "object",
      "required": [
        "create",
        "username",
        "password"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "topologySpreadConstraint": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ticketflow": {
      "type": "object",
      "description": "Zentrale Werte aus gitops/env/cluster.yaml (von ArgoCD per Multi-Source durchgereicht).",
      "required": [
        "imageRegistry",
        "imageTag"
      ],
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        },
        "imageTag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        }
      }
    }
  }
}
