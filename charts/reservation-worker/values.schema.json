{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "reservation-worker",
  "type": "object",
  "required": ["image", "replicaCount", "config", "database", "databaseSecret"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "latest" }
        },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "required": ["kafkaBrokers", "reservationTopic", "resultTopic", "consumerGroup", "registryUrl"],
      "properties": {
        "kafkaBrokers": { "type": "string", "minLength": 1 },
        "reservationTopic": { "type": "string", "minLength": 1 },
        "resultTopic": { "type": "string", "minLength": 1 },
        "consumerGroup": { "type": "string", "minLength": 1 },
        "processMaxRetries": { "type": "integer", "minimum": 0 },
        "processRetryBackoff": { "type": "string", "minLength": 1 },
        "registryUrl": { "type": "string", "minLength": 1 },
        "registryGroupId": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string" },
        "httpAddr": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "name", "sslMode"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sslMode": { "type": "string", "minLength": 1 }
      }
    },
    "databaseSecret": {
      "type": "object",
      "required": ["create", "username", "password"],
      "properties": {
        "create": { "type": "boolean" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
