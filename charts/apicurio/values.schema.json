{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apicurio",
  "description": "Apicurio Registry (Schema-Registry fuer die Kafka-Event-Contracts). Plattform-Chart, siehe charts/README.md ## apicurio.",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "config",
    "service",
    "resources",
    "podSecurityContext",
    "securityContext",
    "podDisruptionBudget",
    "topologySpreadConstraint",
    "ticketflow"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "storageKind"
      ],
      "properties": {
        "storageKind": {
          "type": "string",
          "enum": [
            "kafkasql",
            "sql",
            "mem"
          ]
        },
        "kafkaBootstrapServers": {
          "type": "string",
          "description": "Leer = abgeleitet aus ticketflow.kafka.clusterName + ticketflow.namespaces.kafka."
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "limits": {
          "$ref": "#/$defs/resourceQuantities"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "topologySpreadConstraint": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ticketflow": {
      "type": "object",
      "required": [
        "namespaces",
        "kafka"
      ],
      "properties": {
        "namespaces": {
          "type": "object",
          "required": [
            "kafka"
          ],
          "properties": {
            "kafka": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "kafka": {
          "type": "object",
          "required": [
            "clusterName"
          ],
          "properties": {
            "clusterName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resourceQuantities": {
      "type": "object",
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ]
        },
        "memory": {
          "type": "string"
        }
      }
    }
  }
}
