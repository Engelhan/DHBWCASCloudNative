# Kopieren nach deploy.env (gitignored) und Werte eintragen, dann:
#
#   python3 scripts/personalize.py
#
# ausfuehren. Ersetzt die unten stehenden Beispielwerte (aktuell die DHBW-Kennung
# "cas438007" des Originalautors) in gitops/**/*.yaml und charts/**/*.yaml durch die eigenen -
# siehe README.md ## Betrieb fuer den Gesamtkontext. Secrets (RFC2136-TSIG-Wert,
# OpenStack-Credentials) bleiben davon unberuehrt - die kommen weiterhin aus
# infra/ansible/secrets.yml bzw. infra/terraform/terraform.tfvars (siehe deren .example-Dateien).
#
# Jeder Wert kann statt aus dieser Datei auch als Umgebungsvariable gesetzt werden, z.B.:
#   GITHUB_REPO_SSH_URL=git@github.com:foo/bar.git python3 scripts/personalize.py
# Eine gesetzte Umgebungsvariable gewinnt vor dem Wert hier in der Datei.

# SSH-Clone-URL des EIGENEN Forks - siehe gitops/README.md ## Privates Repo. Muss auf das
# eigene (private) GitHub-Repo zeigen, nicht auf das Original.
GITHUB_REPO_SSH_URL=git@github.com:<dein-github-user>/<dein-repo-name>.git

# Eigene DHBW-DNS-Zone (self-service.dhbw.cloud, RFC2136-Freigabe) - siehe gitops/README.md
# ## DNS/ACME. Die ArgoCD-Ingress-Hostname (charts/argocd-ingress/values.yaml) leitet sich
# automatisch aus dieser Zone ab ("argocd.<DNS_ZONE>"), da sie sie als Teilstring enthaelt.
DNS_ZONE=<dein-name>-at-<institution>.users.dhbw.site

# ACME-Kontakt-E-Mail fuer die vom ClusterIssuer angeforderten Zertifikate.
ACME_EMAIL=<deine-email>@<domain>

# TSIG-Key-NAME (nur der Bezeichner/Label aus self-service.dhbw.cloud, NICHT das Secret
# selbst - der geheime Wert bleibt in infra/ansible/secrets.yml, siehe dort).
RFC2136_TSIG_KEYNAME=<dein-tsig-keyname>
