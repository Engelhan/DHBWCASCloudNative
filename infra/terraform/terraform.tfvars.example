# Copy to terraform.tfvars (gitignored).

# OpenStack application credential
os_auth_url                      = "https://newstack.dhbw.cloud:5000/v3"
os_region                        = "CHANGE_ME"
os_application_credential_id     = "CHANGE_ME"
os_application_credential_secret = "CHANGE_ME"  # shown only once in the portal

# Network
network_name = "DHBWV6"  # existing, externally routable network

# SSH keypair
ssh_public_key_path  = "~/.ssh/ticketflow_dhbwcloud.pub"
ssh_private_key_path = "~/.ssh/ticketflow_dhbwcloud"
ssh_user             = "ubuntu"

# Base image
image_name = "CHANGE_ME"  # e.g. Ubuntu LTS

# VM sizes
control_plane_flavor = "CHANGE_ME"
worker_flavor        = "CHANGE_ME"

# One worker per simulated region (default 3).
# worker_regions = ["region-a", "region-b", "region-c"]

# Optional suffix for all resource names.
# name_suffix = "CHANGE_ME"
