; Normally generated automatically by Terraform (infra/terraform/main.tf,
; resource "local_file" "ansible_inventory") and then stored, gitignored, as hosts.ini.
; This file only serves as an example/fallback for the manual case.

[control_plane]
ticketflow-cp ansible_host=CHANGE_ME node_ip_v4=CHANGE_ME

[workers]
ticketflow-worker-1 ansible_host=CHANGE_ME node_ip_v4=CHANGE_ME region=region-a
ticketflow-worker-2 ansible_host=CHANGE_ME node_ip_v4=CHANGE_ME region=region-b
ticketflow-worker-3 ansible_host=CHANGE_ME node_ip_v4=CHANGE_ME region=region-c

[k3s_cluster:children]
control_plane
workers

[k3s_cluster:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/ticketflow_dhbwcloud
