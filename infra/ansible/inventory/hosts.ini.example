; Wird normalerweise automatisch von Terraform generiert (infra/terraform/main.tf,
; resource "local_file" "ansible_inventory") und landet dann git-ignoriert unter hosts.ini.
; Diese Datei dient nur als Beispiel/Fallback für den manuellen Fall.

[control_plane]
ticketflow-cp ansible_host=CHANGE_ME

[workers]
ticketflow-worker-1 ansible_host=CHANGE_ME region=region-a
ticketflow-worker-2 ansible_host=CHANGE_ME region=region-b
ticketflow-worker-3 ansible_host=CHANGE_ME region=region-c

[k3s_cluster:children]
control_plane
workers

[k3s_cluster:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/ticketflow_dhbwcloud
