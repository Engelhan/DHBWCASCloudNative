---
# Nach secrets.yml kopieren und echten Wert eintragen. secrets.yml ist gitignored - NICHT
# committen (siehe .gitignore, gleiches Prinzip wie infra/terraform/terraform.tfvars).
#
# Wird ausschliesslich von der Rolle gitops_secrets genutzt, um die RFC2136-TSIG-K8s-Secrets
# anzulegen, die gitops/apps/cert-manager-issuer.yaml und gitops/apps/external-dns.yaml per
# secretKeyRef referenzieren (siehe gitops/README.md ## DNS/ACME). Der Wert darf laut
# CLAUDE.md ## Infra layering nicht im Git-Repo landen - deshalb hier statt in
# charts/cert-manager-config/values.yaml oder gitops/apps/external-dns.yaml.
#
# Fehlt diese Datei (frisches Setup, DNS-Zone noch nicht aktiviert), ueberspringt sich die
# Rolle selbst statt fehlzuschlagen.
rfc2136_tsig_secret_value: "CHANGE_ME"
