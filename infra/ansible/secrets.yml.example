---
# Copy to secrets.yml and fill in the real value. secrets.yml is gitignored - do NOT commit it
# (see .gitignore, same principle as infra/terraform/terraform.tfvars).
#
# Used exclusively by the gitops_secrets role to create the RFC2136 TSIG Kubernetes secrets that
# charts/cert-manager-config and charts/external-dns reference via secretKeyRef (see
# gitops/README.md ## DNS/ACME). According to CLAUDE.md ## Infra layering, the value must never end
# up in the git repo - hence here instead of in a chart's values.yaml.
#
# If this file is missing (fresh setup, DNS zone not activated yet), the role skips itself
# instead of failing.
rfc2136_tsig_secret_value: "CHANGE_ME"
